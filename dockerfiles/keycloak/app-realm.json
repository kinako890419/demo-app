{
  "realm": "app",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "app-oidc",
      "name": "demo-app OIDC login",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8181/api/v1/oidc/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ]
    },
    {
      "clientId": "saml-test",
      "name": "demo-app SAML login",
      "enabled": true,
      "protocol": "saml",
      "publicClient": true,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:8181",
      "redirectUris": [
        "http://localhost:8181/api/v1/saml/login/*"
      ],
      "attributes": {
        "saml.server.signature": "true",
        "saml.assertion.signature": "false",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.force.post.binding": "false",
        "saml.authnstatement": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml_name_id_format": "email",
        "saml_force_name_id_format": "true",
        "saml.server.signature.keyinfo.xmlSigKeyInfoKeyNameTransformer": "NONE"
      },
      "defaultClientScopes": []
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "test@test.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "Oidc",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ]
    },
    {
      "username": "samluser",
      "email": "test@test2.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "Saml",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-pinned-dev",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "200"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            "${KC_SIGNING_PRIVATE_KEY}"
          ],
          "certificate": [
            ""
          ]
        }
      }
    ]
  }
}
